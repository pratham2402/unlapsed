# Copy this file to .env and fill in your keys.
# Never commit .env.

# --- Nebius Token Factory (required for live inference) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# After adding the key, run: uv run python scripts/list_models.py
# Then set these to model IDs that exist on your account.
NEBIUS_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b

# --- Tavily (required for live official-source verification) ---
TAVILY_API_KEY=

# --- LangSmith (optional, for run tracing) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=unlapsed

# --- Other hackathon credits (optional, not used in the MVP) ---
TOLOKA_API_KEY=
TANDEM_API_KEY=

# --- App ---
APP_BASE_URL=http://127.0.0.1:8000
APP_SECRET_KEY=change-me
# The default is an absolute SQLite path inside the project. Override only if needed.
# DATABASE_URL=sqlite:///data/unlapsed.db
DEMO_USER_EMAIL=alex@unlapsed.demo
